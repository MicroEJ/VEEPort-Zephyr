# Build: 7E4D1F7C

menu "VEE Abstraction Layer Configuration"

rsource "./port/*/Kconfig"

config VEEPORT_ESSENTIALS
	default y if MICROEJ_CORE

menu "Debug and Diagnostics"

config MICROEJ_DEBUG_MODE
	bool "Activate Debug Information"
	default y
	help
		Enables debug information and increases image size.

config LOG_FUNC_NAME_PREFIX_DBG
	# The debug traces of the abstraction layers do not name the function they come from,
	# they rely on this prefix instead. The traces logged on entry of an abstraction layer
	# function carry no message at all, so turning it off makes them unreadable.
	default y

endmenu

if MICROEJ_DEBUG_MODE
config ASSERT
	default y
config BOOT_BANNER
	default y
config DEBUG
	default y
config THREAD_NAME
	default y
endif

config VEE_LIB_LINK
	bool "Link with vee/lib"
	default y

endmenu
