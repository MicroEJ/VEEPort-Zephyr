config MICROEJ_BLUETOOTH
	bool "Build Bluetooth Abstraction Layer"
	default y
	select MICROEJ_BT_SSL_ERROR if MICROEJ_SSL

config MICROEJ_BT_SSL_ERROR
	bool "Bluetooth cannot be enabled together with MICROEJ_SSL"
	default n

if MICROEJ_BLUETOOTH && !MICROEJ_BT_SSL_ERROR

module = MICROEJ_BLUETOOTH
module-str = the MicroEJ Bluetooth Abstraction Layer
# Default to ERR instead of LOG_DEFAULT_LEVEL. Keep this block before the template: the first default wins.
choice MICROEJ_BLUETOOTH_LOG_LEVEL_CHOICE
	default MICROEJ_BLUETOOTH_LOG_LEVEL_ERR
endchoice
source "subsys/logging/Kconfig.template.log_config"

config MICROEJ_BLUETOOTH_UNPAIR_ON_ENABLE
	bool "Remove every bond when enabling Bluetooth"
	default n
	help
		Removes every bond, and the GATT state attached to it, each time the
		application enables Bluetooth.

