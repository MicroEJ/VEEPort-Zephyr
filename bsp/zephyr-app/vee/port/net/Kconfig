config MICROEJ_NET
	bool "Build Network Abstraction Layer"
	default y

if MICROEJ_NET

module = MICROEJ_NET
module-str = the MicroEJ Network Abstraction Layer
# Default to ERR instead of LOG_DEFAULT_LEVEL. Keep this block before the template: the first default wins.
choice MICROEJ_NET_LOG_LEVEL_CHOICE
	default MICROEJ_NET_LOG_LEVEL_ERR
endchoice
source "subsys/logging/Kconfig.template.log_config"

config MICROEJ_ASYNC_SELECT_TASK_PRIORITY
	int
	# Must stay above the VM (CONFIG_MAIN_THREAD_PRIORITY) or a CPU-bound Java
	# thread starves this task and parked socket operations never resume.
	# See the MicroEJ task priority layout in main/prj.conf.
	default 1

