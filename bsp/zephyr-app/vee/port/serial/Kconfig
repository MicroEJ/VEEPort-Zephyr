# Build: 7E4D1F7C

config MICROEJ_SERIAL
	bool "Build Serial Abstraction Layer"
	default y
	select UART_ASYNC_API
	select UART_USE_RUNTIME_CONFIGURE

if MICROEJ_SERIAL

module = MICROEJ_SERIAL
module-str = the MicroEJ Serial Abstraction Layer
# Default to ERR instead of LOG_DEFAULT_LEVEL. Keep this block before the template: the first default wins.
choice MICROEJ_SERIAL_LOG_LEVEL_CHOICE
	default MICROEJ_SERIAL_LOG_LEVEL_ERR
endchoice
source "subsys/logging/Kconfig.template.log_config"


config MICROEJ_SERIAL_NOCACHE_BUFFERS 
	bool "Use non-cached buffers for cache-coherent UART transfers (could be required for some DMA)"
	default n
	select NOCACHE_MEMORY

config MICROEJ_SERIAL_ENABLE_PORT_0
	bool "Enable Serial Port 0"
	default y

config MICROEJ_SERIAL_ENABLE_PORT_1
	bool "Enable Serial Port 1"
	default y

config MICROEJ_SERIAL_READ_TIMEOUT
	int "Read timeout in milliseconds"
	default 2000

config MICROEJ_SERIAL_RX_RING_BUFFER_SIZE
	int "RX ring buffer size in bytes"
	default 512

config MICROEJ_SERIAL_RX_BUFFER_NUMBER
	int "Number of RX buffers"
	default 1

config MICROEJ_SERIAL_RX_BUFFER_SIZE
	int "RX buffer size in bytes"
	default 256

config MICROEJ_SERIAL_TX_BUFFER_SIZE
	int "TX buffer size in bytes"
	default 256

endif