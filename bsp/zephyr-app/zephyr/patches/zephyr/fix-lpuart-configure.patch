diff --git a/drivers/serial/uart_mcux_lpuart.c b/drivers/serial/uart_mcux_lpuart.c
index 67685673065..f2f241abd97 100644
--- a/drivers/serial/uart_mcux_lpuart.c
+++ b/drivers/serial/uart_mcux_lpuart.c
@@ -1228,6 +1228,19 @@ static int mcux_lpuart_configure(const struct device *dev,
 				 const struct uart_config *cfg)
 {
 	const struct mcux_lpuart_config *config = dev->config;
+	lpuart_config_t uart_config;
+	int ret;
+
+	/* Pre-validate params before touching hardware. LPUART_Deinit disables the peripheral
+	* clock (when FSL_SDK_DISABLE_DRIVER_CLOCK_CONTROL is not set); if init subsequently
+	* fails, the clock stays disabled and any register access causes a bus fault.
+	* mcux_lpuart_configure_basic only translates enums — no register access — so it is
+	* safe to call before deinit. */
+	LPUART_GetDefaultConfig(&uart_config);
+	ret = mcux_lpuart_configure_basic(dev, cfg, &uart_config);
+	if (ret) {
+		return ret;
+	}
 
 	/* Make sure that RSRC is de-asserted otherwise deinit will hang. */
 	config->base->CTRL &= ~LPUART_CTRL_RSRC_MASK;
@@ -1235,7 +1248,7 @@ static int mcux_lpuart_configure(const struct device *dev,
 	/* disable LPUART */
 	LPUART_Deinit(config->base);
 
-	int ret = mcux_lpuart_configure_init(dev, cfg);
+	ret = mcux_lpuart_configure_init(dev, cfg);
 	if (ret) {
 		return ret;
 	}
